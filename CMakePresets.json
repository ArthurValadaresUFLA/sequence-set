{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 28,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "default",
      "displayName": "Release",
      "description": "Compilação otimizada, sem documentação.",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "debug",
      "displayName": "Debug",
      "description": "Compilação com símbolos de depuração.",
      "inherits": "default",
      "binaryDir": "${sourceDir}/build/debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "docs",
      "displayName": "Release + Doxygen",
      "description": "Compilação otimizada com o alvo docs habilitado.",
      "inherits": "default",
      "binaryDir": "${sourceDir}/build/docs",
      "cacheVariables": {
        "SEQUENCE_SET_BUILD_DOCS": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "default",
      "configurePreset": "default"
    },
    {
      "name": "debug",
      "configurePreset": "debug"
    },
    {
      "name": "docs",
      "configurePreset": "docs"
    }
  ]
}
